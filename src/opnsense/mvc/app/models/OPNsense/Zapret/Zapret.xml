<model>
    <mount>//OPNsense/Zapret</mount>
    <description>Zapret2 DPI Bypass Configuration</description>
    <version>2.2.0</version>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <waninterface type="InterfaceField">
                <Required>N</Required>
                <AllowDynamic>Y</AllowDynamic>
                <AddParentDevices>Y</AddParentDevices>
            </waninterface>
            <divertport type="PortField">
                <Default>989</Default>
                <Required>Y</Required>
                <ValidationMessage>Please enter a valid port number.</ValidationMessage>
            </divertport>
            <ports type="TextField">
                <Default>80,443</Default>
                <Required>Y</Required>
                <Mask>/^[0-9,]+$/</Mask>
                <ValidationMessage>Please enter comma-separated port numbers.</ValidationMessage>
            </ports>
            <udpports type="TextField">
                <Required>N</Required>
                <Mask>/^[0-9,\-\s]*$/</Mask>
                <ValidationMessage>Please enter UDP ports or ranges separated by commas (1-65535).</ValidationMessage>
            </udpports>
            <sourcenets type="NetworkField">
                <Required>N</Required>
                <NetMaskAllowed>Y</NetMaskAllowed>
                <AddressFamily>ipv4</AddressFamily>
                <AsList>Y</AsList>
                <FieldSeparator>,</FieldSeparator>
                <ValidationMessage>Please enter valid IPv4 addresses or networks in CIDR notation (e.g. 192.168.1.0/24).</ValidationMessage>
            </sourcenets>
        </general>
        <strategy>
            <httpargs type="TextField">
                <Required>N</Required>
            </httpargs>
            <httpsargs type="TextField">
                <Required>N</Required>
            </httpsargs>
            <quicargs type="TextField">
                <Required>N</Required>
            </quicargs>
            <udpfilterl7 type="TextField">
                <Required>N</Required>
                <Mask>/^[a-zA-Z0-9_,\-]*$/</Mask>
                <ValidationMessage>Use comma-separated protocol names containing only letters, digits, underscores, or hyphens.</ValidationMessage>
            </udpfilterl7>
            <udpargs type="TextField">
                <Required>N</Required>
                <Mask>/^[a-zA-Z0-9_,.:=+ \-]*$/</Mask>
                <ValidationMessage>Use zapret2 profile arguments with letters, digits, spaces, and supported argument punctuation only.</ValidationMessage>
            </udpargs>
            <extraargs type="TextField">
                <Required>N</Required>
            </extraargs>
        </strategy>
        <youtube>
            <tcpenabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </tcpenabled>
            <tcpstrategy type="TextField">
                <Required>N</Required>
                <Mask>/^[a-zA-Z0-9_,.:=+ \-]*$/</Mask>
                <ValidationMessage>Use only zapret2 --payload and --lua-desync arguments.</ValidationMessage>
            </tcpstrategy>
            <quicenabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </quicenabled>
            <quicstrategy type="TextField">
                <Required>N</Required>
                <Mask>/^[a-zA-Z0-9_,.:=+ \-]*$/</Mask>
                <ValidationMessage>Use only zapret2 --payload and --lua-desync arguments.</ValidationMessage>
            </quicstrategy>
            <domains type="TextField">
                <Required>N</Required>
                <Mask>/^[a-zA-Z0-9\.\-\^\n\r\s]*$/</Mask>
            </domains>
        </youtube>
        <discord>
            <tcpenabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </tcpenabled>
            <tcpstrategy type="TextField">
                <Required>N</Required>
                <Mask>/^[a-zA-Z0-9_,.:=+ \-]*$/</Mask>
                <ValidationMessage>Use only zapret2 --payload and --lua-desync arguments.</ValidationMessage>
            </tcpstrategy>
            <domains type="TextField">
                <Required>N</Required>
                <Mask>/^[a-zA-Z0-9\.\-\^\n\r\s]*$/</Mask>
            </domains>
        </discord>
        <ipset>
            <includeenabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </includeenabled>
            <includefile type="TextField">
                <Default>ipset-all.txt</Default>
                <Required>N</Required>
                <Mask>/^[a-zA-Z0-9][a-zA-Z0-9_.-]*$/</Mask>
                <ValidationMessage>Enter a filename only, without a directory path.</ValidationMessage>
            </includefile>
            <excludeenabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </excludeenabled>
            <excludefile type="TextField">
                <Default>ipset-exclude-default.txt</Default>
                <Required>N</Required>
                <Mask>/^[a-zA-Z0-9][a-zA-Z0-9_.-]*$/</Mask>
                <ValidationMessage>Enter a filename only, without a directory path.</ValidationMessage>
            </excludefile>
        </ipset>
        <hostlist>
            <mode type="OptionField">
                <Default>all</Default>
                <OptionValues>
                    <all>All traffic on configured ports</all>
                    <list>Only listed domains</list>
                    <auto>Auto-detect blocked domains</auto>
                </OptionValues>
                <Required>Y</Required>
            </mode>
            <domains type="TextField">
                <Required>N</Required>
                <Mask>/^[a-zA-Z0-9\.\-\n\r\s]*$/</Mask>
            </domains>
            <excludedomains type="TextField">
                <Required>N</Required>
                <Mask>/^[a-zA-Z0-9\.\-\n\r\s]*$/</Mask>
            </excludedomains>
        </hostlist>
    </items>
</model>
